# 토스증권 WTS > 설정 > Open API 에서 받은 값 (따옴표 없이)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 텔레그램 (선택): 어디서나 휴대폰으로 상태 보기·시작·종료 + 매매 알림
TG_TOKEN=
TG_CHAT=

# 같은 와이파이의 휴대폰 브라우저로 화면 열기 (선택): APP_LAN=1 과 PIN(4~8자리 숫자)
APP_LAN=0
APP_PIN=

# 미장 SEC 공시 확인용 연락처(User-Agent). 비우면 config 의 sec_user_agent 사용
# SEC_UA=이름 이메일
